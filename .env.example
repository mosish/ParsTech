# ==============================================================================
# ParsTech Phase 1 — Environment Configuration Placeholders (.env.example)
# Copy to .env on the Ubuntu host and set chmod 600 .env.
# NEVER commit actual secrets or production credentials to version control.
# ==============================================================================

# 1. PostgreSQL Database Connection (Prisma)
# Production format: postgresql://parstech_app:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/parstech_prod?schema=public
DATABASE_URL="postgresql://parstech_app:REPLACE_WITH_STRONG_DB_PASSWORD@127.0.0.1:5432/parstech_dev?schema=public"

# Separate test database URL used exclusively by automated tests (never point to production!)
TEST_DATABASE_URL="postgresql://parstech_app:REPLACE_WITH_STRONG_DB_PASSWORD@127.0.0.1:5432/parstech_test?schema=public"

# Docker Compose PostgreSQL container credentials
POSTGRES_USER="parstech_app"
POSTGRES_PASSWORD="REPLACE_WITH_STRONG_DB_PASSWORD"
POSTGRES_DB="parstech_prod"

# 2. Canonical Origin & Environment
# Single trusted absolute URL source used for canonical links, sitemap.xml, robots.txt, and CSRF Origin verification
PRIMARY_ORIGIN="https://parstech.example.com"
APP_ENV="production"

# 3. Reverse Proxy & Session Security
# Comma-separated list of trusted reverse proxy IPs allowed to supply X-Forwarded-For / X-Real-IP
TRUSTED_PROXY_IPS="127.0.0.1,::1"
SESSION_TTL_HOURS="12"

# 4. Optional Staging Protection (Only when APP_ENV="staging")
# When STAGING_BASIC_AUTH_USER and STAGING_BASIC_AUTH_PASS are set, middleware enforces HTTP Basic Auth + X-Robots-Tag: noindex
STAGING_BASIC_AUTH_USER=""
STAGING_BASIC_AUTH_PASS=""

# 5. Optional Verified Business Information (Omitted from public UI & JSON-LD if left blank)
VERIFIED_BUSINESS_NAME=""
VERIFIED_BUSINESS_PHONE=""
VERIFIED_BUSINESS_ADDRESS=""

# 6. Database Backup Configuration (scripts/backup-db.sh)
BACKUP_DIR="/var/backups/parstech-postgres"
BACKUP_RETENTION_DAYS="14"
OFFSITE_BACKUP_TARGET=""
